# Copy to .env and fill in. .env is gitignored and must never be committed.

# Groq API key — free tier is sufficient. https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional model overrides. Defaults are set in src/ollama_client.py and
# src/llm_judge.py. Each Groq model has its own per-day token budget on the
# free tier, so these exist to move a run to a model that still has headroom.
# GROQ_MODEL=groq/compound-mini
# JUDGE_GROQ_MODEL=openai/gpt-oss-120b

# No key? Run entirely locally instead:
#   ollama pull llama3.2
#   python scripts/run_evaluation.py --benchmark headline --local
